# Public API URL only. Never place Supabase service-role keys in VITE_ values.
# Leave empty to keep external uploads disabled.
VITE_REPORT_STORAGE_ENDPOINT=
# Supabase legacy anon JWT (public browser key); never the service-role key.
VITE_REPORT_STORAGE_ANON_KEY=
# Override only when testing a local phone report; production defaults to GitHub Pages.
VITE_PUBLIC_REPORT_URL=
# Personal Finding interpretation (supabase/functions/interpret). A plain URL —
# the model key lives in the function, never here. Leave empty to keep the
# Final Report on its own template copy.
#   supabase secrets set ANTHROPIC_API_KEY=...
#   supabase secrets set INTERPRET_ALLOWED_ORIGINS=https://libe396.github.io,http://localhost:5199
#   supabase functions deploy interpret
VITE_REPORT_INTERPRETATION_ENDPOINT=
